rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// FIRESTORE SECURITY RULES — The Jaaga Desk
//
// Deploy with:  firebase deploy --only firestore:rules
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isAdminOrEditor() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "editor"];
    }

    function canWrite() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "editor", "author"];
    }

    // Whitelist for fields the public may bump on a post (just the view counter)
    function isPublicViewBump() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["views"]);
    }


    // ── USERS ────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }


    // ── POSTS ────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read:   if true;
      allow create: if canWrite();

      // Author can edit own post, editors/admins can edit anything,
      // anyone (even guests) can bump the public view counter.
      allow update: if isPublicViewBump()
                    || (isSignedIn() && (resource.data.author == request.auth.uid || isAdminOrEditor()))
                    // Allow signed-in users to bump the likes counter (LikesAPI batch)
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes"]));

      allow delete: if isAdmin();
    }


    // ── COMMENTS ─────────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read:   if true;
      allow create: if true;
      allow delete: if isSignedIn() && (resource.data.author == request.auth.uid || isAdmin());
      // Only allow updating reaction counters
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes", "dislikes"]);

      match /replies/{replyId} {
        allow read:   if true;
        allow create: if true;
        allow delete: if isSignedIn() && (resource.data.author == request.auth.uid || isAdmin());
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes", "dislikes"]);
      }
    }

    // ── COMMENT REACTIONS ────────────────────────────────────────────────
    match /commentReactions/{reactionId} {
      allow read:                 if true;
      allow create, update, delete: if true;
    }


    // ── SUBSCRIBERS ──────────────────────────────────────────────────────
    match /subscribers/{email} {
      allow read:   if isAdmin();
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }


    // ── LIKES ────────────────────────────────────────────────────────────
    match /likes/{likeId} {
      allow read:           if true;
      allow create, delete: if isSignedIn();
      allow update:         if false;
    }


    // ── BOOKMARKS ────────────────────────────────────────────────────────
    match /bookmarks/{userId} {
      allow read:                   if isOwner(userId);
      allow create, update, delete: if isOwner(userId);
    }


    // ── CATEGORIES ───────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read:                   if true;
      allow create, update, delete: if isAdmin();
    }


    // ── SITE SETTINGS ────────────────────────────────────────────────────
    // Public reads (header logo, hero slides, footer copy etc.)
    // Only admins can modify.
    match /settings/{docId} {
      allow read:                   if true;
      allow create, update, delete: if isAdmin();
    }


    // ── ACTIVITY LOG ─────────────────────────────────────────────────────
    match /activity/{activityId} {
      allow read:           if isAdmin();
      allow create:         if isSignedIn();
      allow update, delete: if false;
    }


    // ── READING HISTORY ──────────────────────────────────────────────────
    match /readHistory/{userId} {
      allow read:                   if isOwner(userId);
      allow create, update, delete: if isOwner(userId);
    }
  }
}
